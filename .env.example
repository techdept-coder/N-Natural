# n8n production webhook URL (server-side only — used by /api/apply)
# Example: https://n8n.sparkprosalon.com/webhook/careers-application
WEBHOOK_URL=

# Google Sheet holding the job postings (server-side only — used by /api/page).
# SHEET_ID is the long string in the sheet URL between /d/ and /edit.
# SHEET_GID is the gid=... value for the "Form Responses" tab.
SHEET_ID=
SHEET_GID=
